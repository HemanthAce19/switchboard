# Copy to .env and export the values (for example: set -a; source .env; set +a).
# Every variable is optional. The values shown are the defaults.

# Leave empty for demo mode: no network, canned agents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

MAX_TASKS=8
MAX_CONCURRENCY=3
TASK_TIMEOUT_S=60
MAX_TOTAL_TOKENS=60000
DATABASE_PATH=switchboard.db
DEMO_DELAY_S=0.8
CORS_ORIGINS=http://localhost:3000
